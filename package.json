{
  "name": "@rljson/cars-origin-master",
  "version": "0.0.1",
  "description": "Master of the origin side of the cars example app, where catalogs are captured originally",
  "homepage": "https://github.com/rljson/cars-origin-master",
  "bugs": "https://github.com/rljson/cars-origin-master/issues",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rljson/cars-origin-master.git"
  },
  "main": "dist/cars-origin-master.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm exec vite build && tsc && node scripts/copy-readme-to-dist.js",
    "test": "pnpm exec vitest run --coverage && pnpm run lint",
    "prebuild": "npm run test",
    "prepublishOnly": "npm run build",
    "lint": "pnpm exec eslint",
    "updateGoldens": "cross-env UPDATE_GOLDENS=true pnpm test"
  },
  "devDependencies": {
    "@rljson/dna-rljson": "^0.3.2",
    "@rljson/json": "0.0.23",
    "@tssuite/helix-js": "^0.5.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "eslint": "~10.14.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^17.14.0",
    "jsdoc": "^4.0.5",
    "read-pkg": "^10.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0",
    "vitest-dom": "^0.1.1"
  },
  "packageManager": "pnpm@10.11.0"
}
